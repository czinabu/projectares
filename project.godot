; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Verge"
config/use_custom_user_dir=true
config/custom_user_dir_name="Project Ares"
config/description="Full-loot PvPvE extraction game with plug-in worlds."
run/main_scene="res://scenes/start.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/icon.png"
config/windows_native_icon="res://assets/branding/icon.ico"
boot_splash/bg_color=Color(0.035, 0.031, 0.043, 1)
boot_splash/image="res://assets/branding/splash.png"

[ares]

stability/enemies=false
stability/enemy_cap=8
stability/enemies_full_detail=12
release/playtest_worlds=PackedStringArray("plaza", "rift", "marsh", "dunes", "frostline")
release/launch_scope=true
release/launch_worlds=PackedStringArray("plaza", "ashfront", "frostline")

[autoload]

Boot="*res://core/boot.gd"
Updater="*res://core/update/updater.gd"
InputSetup="*res://core/input_setup.gd"
ItemDB="*res://core/items/item_db.gd"
Look="*res://core/visual/look.gd"
Worlds="*res://core/world/world_registry.gd"
Profile="*res://core/profile/profile.gd"
Sfx="*res://core/fx/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="actors"
3d_physics/layer_3="interactables"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/screen_space_aa=2
